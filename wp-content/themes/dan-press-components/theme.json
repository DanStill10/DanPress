{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "duotone": [],
      "palette": [
        {
          "name": "Background",
          "slug": "dsd-bg",
          "color": "#111111"
        },
        {
          "name": "Elevated",
          "slug": "dsd-bg-elevated",
          "color": "#1a1a1a"
        },
        {
          "name": "Text",
          "slug": "dsd-text",
          "color": "#ffffff"
        },
        {
          "name": "Muted",
          "slug": "dsd-muted",
          "color": "#999999"
        },
        {
          "name": "Border",
          "slug": "dsd-border",
          "color": "#333333"
        },
        {
          "name": "Accent",
          "slug": "dsd-accent",
          "color": "#0066FF"
        }
      ]
    },
    "spacing": {
      "padding": true,
      "units": [
        "px",
        "%",
        "em",
        "rem",
        "vw",
        "vh"
      ]
    },
    "typography": {
      "customFontSize": false,
      "fontFamilies": [
        {
          "name": "Inter",
          "slug": "dsd-sans",
          "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        },
        {
          "name": "Mono",
          "slug": "dsd-mono",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "name": "xs",
          "slug": "xs",
          "size": "0.75rem"
        },
        {
          "name": "sm",
          "slug": "sm",
          "size": "0.875rem"
        },
        {
          "name": "base",
          "slug": "base",
          "size": "1rem"
        },
        {
          "name": "lg",
          "slug": "lg",
          "size": "1.125rem"
        },
        {
          "name": "xl",
          "slug": "xl",
          "size": "1.25rem"
        },
        {
          "name": "2xl",
          "slug": "2xl",
          "size": "1.5rem"
        },
        {
          "name": "3xl",
          "slug": "3xl",
          "size": "1.875rem"
        },
        {
          "name": "4xl",
          "slug": "4xl",
          "size": "2.25rem"
        },
        {
          "name": "5xl",
          "slug": "5xl",
          "size": "3rem"
        },
        {
          "name": "6xl",
          "slug": "6xl",
          "size": "3.75rem"
        },
        {
          "name": "7xl",
          "slug": "7xl",
          "size": "4.5rem"
        },
        {
          "name": "8xl",
          "slug": "8xl",
          "size": "6rem"
        },
        {
          "name": "9xl",
          "slug": "9xl",
          "size": "8rem"
        }
      ]
    }
  }
}
