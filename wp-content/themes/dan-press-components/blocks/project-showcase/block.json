{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "dsd-lib/showcase-card",
  "title": "DSD Project Showcase",
  "category": "theme",
  "icon": "portfolio",
  "description": "A high-contrast project card featuring deployment status, tech stack, and repository link.",
  "attributes": {
    "title": {
      "type": "string",
      "default": "PROJECT_NAME"
    },
    "tagline": {
      "type": "string",
      "default": "System microservice or architectural feature."
    },
    "envTag": {
      "type": "string",
      "default": "PRODUCTION"
    },
    "techList": {
      "type": "string",
      "default": "WordPress, React, Node.js"
    },
    "repoLink": {
      "type": "string",
      "default": "#"
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css"
}
