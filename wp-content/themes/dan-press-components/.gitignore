# -----------------------------------------------------------------------------
# WordPress Theme .gitignore (Production / CI/CD Ready)
# For: /wp-content/themes/dan-press-components/
# -----------------------------------------------------------------------------

# Build Artifacts
# These directories contain the compiled CSS and JavaScript.
# They are generated by `npx bud build` and `yarn build` in the pipeline.
/public/
/build/

# Dependency Directories
# These are installed by the pipeline, not stored in Git.
/node_modules/
/vendor/

# Bud.js cache & temporary files
.budfiles/
.cache/

# Log files, OS files, and editor configs
# ---------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bud-debug.log*
php_errorlog
debug.log
.DS_Store
.vscode/
.idea/
*.swp
*~
composer.phar
*.bak
