{
    "key": "group_client_logos",
    "title": "Client Logos",
    "fields": [
        {
            "key": "field_cl_heading",
            "label": "Section Heading",
            "name": "cl_heading",
            "type": "text",
            "default_value": "Our Clients",
            "instructions": "Section heading. Wrap a word in [accent] tags to highlight it in accent color.",
            "required": 0
        },
        {
            "key": "field_cl_clients",
            "label": "Client Logos",
            "name": "clients",
            "type": "repeater",
            "layout": "table",
            "button_label": "Add Logo",
            "min": 1,
            "max": 48,
            "instructions": "Upload client logos. White/monochrome logos work best on dark backgrounds."
        },
        {
            "key": "field_cl_logo_image",
            "label": "Logo Image",
            "name": "cl_logo_image",
            "type": "image",
            "return_format": "array",
            "preview_size": "thumbnail",
            "mime_types": "png,svg,jpg,jpeg",
            "parent_repeater": "field_cl_clients"
        },
        {
            "key": "field_cl_logo_link",
            "label": "Link (optional)",
            "name": "cl_logo_link",
            "type": "url",
            "parent_repeater": "field_cl_clients"
        },
        {
            "key": "field_cl_logo_alt",
            "label": "Alt Text",
            "name": "cl_logo_alt",
            "type": "text",
            "parent_repeater": "field_cl_clients",
            "instructions": "Company name for accessibility."
        },
        {
            "key": "field_cl_color_scheme",
            "label": "Color Scheme",
            "name": "color_scheme",
            "type": "select",
            "choices": {
                "default": "Default (dark)",
                "primary": "Primary (blue accent bg)",
                "secondary": "Secondary (elevated bg)",
                "custom": "Custom (set your own colors)"
            },
            "default_value": "default",
            "instructions": "Controls the section background and text colors."
        },
        {
            "key": "field_cl_custom_bg",
            "label": "Custom Background Color",
            "name": "custom_bg_color",
            "type": "color_picker",
            "conditional_logic": [
                [
                    [
                        "field": "field_cl_color_scheme",
                        "operator": "==",
                        "value": "custom"
                    ]
                ]
            ]
        },
        {
            "key": "field_cl_custom_text",
            "label": "Custom Text Color",
            "name": "custom_text_color",
            "type": "color_picker",
            "conditional_logic": [
                [
                    [
                        "field": "field_cl_color_scheme",
                        "operator": "==",
                        "value": "custom"
                    ]
                ]
            ]
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/client-logos"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true,
    "show_in_rest": 0,
    "modified": 1784800000
}
