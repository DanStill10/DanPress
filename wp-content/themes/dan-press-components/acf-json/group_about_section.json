{
    "key": "group_about_section",
    "title": "About / Why Partner With Us",
    "fields": [
        {
            "key": "field_about_heading",
            "label": "Heading (first word will be accented)",
            "name": "about_heading",
            "type": "text",
            "required": 0,
            "default_value": "Why Partner With Us"
        },
        {
            "key": "field_about_btn_text",
            "label": "Button Text",
            "name": "about_btn_text",
            "type": "text",
            "required": 0,
            "placeholder": "Browse Our Portfolio"
        },
        {
            "key": "field_about_btn_url",
            "label": "Button URL",
            "name": "about_btn_url",
            "type": "url",
            "required": 0
        },
        {
            "key": "field_about_subtitle",
            "label": "Subtitle",
            "name": "about_subtitle",
            "type": "text",
            "required": 0,
            "placeholder": "Singapore Web Design Agency"
        },
        {
            "key": "field_about_description",
            "label": "Description",
            "name": "about_description",
            "type": "wysiwyg",
            "required": 0,
            "tabs": "all",
            "toolbar": "basic",
            "media_upload": 0,
            "rows": 6
        },
        {
            "key": "field_about_portfolio_images",
            "label": "Portfolio Screenshots",
            "name": "about_portfolio_images",
            "type": "gallery",
            "return_format": "array",
            "preview_size": "medium",
            "insert_size": "medium",
            "mime_types": "jpg,jpeg,png,webp"
        }
    ],
    "location": [
        [
            {
                "param": "page_template",
                "operator": "==",
                "value": "front-page.php"
            }
        ]
    ],
    "menu_order": 3,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}
