{
    "key": "group_services_grid",
    "title": "Services Grid",
    "fields": [
        {
            "key": "field_services_repeater",
            "label": "Services",
            "name": "services",
            "type": "repeater",
            "layout": "table",
            "button_label": "Add Service",
            "min": 1,
            "max": 8,
            "sub_fields": [
                {
                    "key": "field_service_icon",
                    "label": "Icon (SVG path data)",
                    "name": "service_icon",
