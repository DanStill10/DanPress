{
    "key": "group_sv_services",
    "title": "Services Grid",
    "fields": [
        {
            "key": "field_sv_heading",
            "label": "Section Heading",
            "name": "sv_heading",
            "type": "text",
            "default_value": "Solutions We [accent]Provide[/accent]",
            "instructions": "Section heading. Wrap a word in [accent] tags to highlight it."
        },
        {
            "key": "field_sv_category",
            "label": "Card Category Label",
            "name": "sv_category",
            "type": "text",
            "default_value": "OUR SOLUTIONS",
            "instructions": "Small label above each card title."
        },
        {
            "key": "field_sv_btn_text",
            "label": "Button Label (all cards)",
            "name": "sv_btn_text",
            "type": "text",
            "default_value": "Learn More",
            "instructions": "Pill button text shown on every card."
        },
        {
            "key": "field_sv_cards",
            "label": "Service Cards",
            "name": "sv_cards",
            "type": "repeater",
            "layout": "table",
            "button_label": "Add Service",
            "min": 1,
            "max": 12
        },
        {
            "key": "field_sv_bg_image",
            "label": "Background Image",
            "name": "sv_bg_image",
            "type": "image",
            "return_format": "array",
            "preview_size": "thumbnail",
            "mime_types": "jpg,jpeg,png,webp",
            "parent_repeater": "field_sv_cards",
            "instructions": "Full-bleed card background. Use high-res landscape images."
        },
        {
            "key": "field_sv_icon",
            "label": "Icon",
            "name": "sv_icon",
            "type": "image",
            "return_format": "array",
            "preview_size": "thumbnail",
            "mime_types": "svg,png",
            "parent_repeater": "field_sv_cards",
            "instructions": "Optional SVG or PNG icon."
        },
        {
            "key": "field_sv_title",
            "label": "Title",
            "name": "sv_title",
            "type": "text",
            "parent_repeater": "field_sv_cards",
            "required": 1
        },
        {
            "key": "field_sv_description",
            "label": "Description",
            "name": "sv_description",
            "type": "textarea",
            "parent_repeater": "field_sv_cards",
            "rows": 2,
            "new_lines": "wpautop"
        },
        {
            "key": "field_sv_link",
            "label": "Card Link",
            "name": "sv_link",
            "type": "url",
            "parent_repeater": "field_sv_cards",
            "instructions": "Where this card links to. Leave empty for no navigation."
        },
        {
            "key": "field_sv_color_scheme",
            "label": "Color Scheme",
            "name": "color_scheme",
            "type": "select",
            "choices": {
                "default": "Default (dark)",
                "primary": "Primary (blue accent bg)",
                "secondary": "Secondary (elevated bg)",
                "custom": "Custom (set your own colors)"
            },
            "default_value": "default"
        },
        {
            "key": "field_sv_custom_bg",
            "label": "Custom Background Color",
            "name": "custom_bg_color",
            "type": "color_picker",
            "conditional_logic": [
                [
                    [
                        "field": "field_sv_color_scheme",
                        "operator": "==",
                        "value": "custom"
                    ]
                ]
            ]
        },
        {
            "key": "field_sv_custom_text",
            "label": "Custom Text Color",
            "name": "custom_text_color",
            "type": "color_picker",
            "conditional_logic": [
                [
                    [
                        "field": "field_sv_color_scheme",
                        "operator": "==",
                        "value": "custom"
                    ]
                ]
            ]
        }
