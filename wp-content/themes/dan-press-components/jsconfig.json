{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@scripts/*": ["resources/scripts/*"],
      "@styles/*": ["resources/styles/*"],
      "@images/*": ["resources/images/*"],
      "@fonts/*": ["resources/fonts/*"],
      "@blocks/*": ["blocks/*"]
    }
  },
  "include": [
    "resources/**/*",
    "blocks/**/*",
    "bud.config.mjs"
  ],
  "exclude": [
    "node_modules",
    "public",
    "vendor"
  ]
}