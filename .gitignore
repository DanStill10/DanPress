# -----------------------------------------------------------------------------
# WordPress Project Root .gitignore (Production / CI/CD Ready)
# -----------------------------------------------------------------------------

# WordPress Core Files & Directories
/wp-admin/
/wp-includes/
/wp-*.php
!wp-config.php
index.php
license.txt
readme.html
xmlrpc.php

# CRITICAL: Ignore the WordPress configuration file for security.
# wp-config.php

# Lando specific files to ignore (if any beyond .lando.yml)
# .lando.tmp/

# WP-CONTENT Folder
# -----------------
# Plugins and mu-plugins are installed at deploy time, not tracked in Git.
/wp-content/plugins/*
!/wp-content/plugins/advanced-custom-fields-pro/
/wp-content/mu-plugins/

# User uploads should not be in the repository.
# They should be synced separately or stored on a service like S3.
/wp-content/uploads/

# Other standard wp-content directories to ignore
/wp-content/upgrade/
/wp-content/backups/
/wp-content/cache/
wp-content/advanced-cache.php
wp-content/object-cache.php
wp-content/wp-cache-config.php

# Dependency Directories (at project root)
# These are installed by the pipeline, not stored in Git.
/node_modules/
/vendor/

# Log files, OS files, and editor configs
# ---------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
php_errorlog
debug.log
.DS_Store
.vscode/
.idea/
*.swp
*~
